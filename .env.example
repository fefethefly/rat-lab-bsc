# Local backend. Secrets stay outside the browser; default is DRY only.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Set explicitly to 1 to enable Flap auth/upload/prepare endpoints.
ENABLE_MAINNET_PREPARE=0
# The autonomous signer uses an encrypted keystore outside this repository.
# Alternatively, explicitly pass --env-file pointing outside the repository.
# Never put the private key in this server environment or in a VITE_ variable. See docs/MAINNET.md.
